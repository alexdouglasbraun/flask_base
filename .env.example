SAML_SP_ACS_URL=http://localhost:5000/auth/saml/acs
SAML_SP_SLS_URL=http://localhost:5000/auth/logout
SAML_IDP_ENTITY_ID=
SAML_IDP_SSO_URL=
SAML_IDP_SLO_URL=
SAML_IDP_X509_CERT=
