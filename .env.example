FLASK_ENV=development
SECRET_KEY=change-me
# Leave DATABASE_URL unset to use local SQLite at instance/app.db.
# DATABASE_URL=sqlite:///app.db
# DATABASE_URL=postgresql+psycopg://flask_user:flask_password@localhost:5432/flask_base
SERVER_NAME=localhost:5000
TRUST_PROXY_HEADERS=false
SCIM_BEARER_TOKEN=change-me-scim-token

SAML_SP_ENTITY_ID=http://localhost:5000/auth/saml/metadata
SAML_SP_ACS_URL=http://localhost:5000/auth/saml/acs
SAML_SP_SLS_URL=http://localhost:5000/auth/saml/sls

SAML_IDP_ENTITY_ID=https://idp.example.com/metadata
SAML_IDP_SSO_URL=https://idp.example.com/sso
SAML_IDP_SLO_URL=https://idp.example.com/slo
SAML_IDP_X509_CERT="-----BEGIN CERTIFICATE-----replace-me-----END CERTIFICATE-----"
